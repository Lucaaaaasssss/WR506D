              "raw": "{\n    \"name\": \"Mon nouveau film\",\n    \"description\": \"Description du film\",\n    \"duration\": 120,\n    \"budget\": 1000000,\n    \"draft\": false,\n    \"online\": true,\n    \"director\": \"/api/directors/1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/movies",
              "host": ["{{base_url}}"],
              "path": ["api", "movies"]
            },
            "description": "Créer un nouveau film (nécessite ROLE_ADMIN)"
          },
          "response": []
        },
        {
          "name": "Update movie (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/ld+json"
              },
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Film modifié\",\n    \"description\": \"Description modifiée\",\n    \"duration\": 150,\n    \"budget\": 2000000,\n    \"draft\": false,\n    \"online\": true,\n    \"director\": \"/api/directors/1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/movies/1",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "1"]
            },
            "description": "Modifier un film existant (nécessite ROLE_ADMIN)"
          },
          "response": []
        },
        {
          "name": "Update movie (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              },
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Film partiellement modifié\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/movies/1",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "1"]
            },
            "description": "Modifier partiellement un film (nécessite ROLE_ADMIN)"
          },
          "response": []
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/movies/1",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "1"]
            },
            "description": "Supprimer un film (nécessite ROLE_ADMIN)"
          },
          "response": []
        },
        {
          "name": "Filter movies by name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/movies?name=Batman",
              "host": ["{{base_url}}"],
              "path": ["api", "movies"],
              "query": [
                {
                  "key": "name",
                  "value": "Batman"
                }
              ]
            },
            "description": "Filtrer les films par nom"
          },
          "response": []
        }
      ]
    },
